{
  "name": "prisma-prim-suite",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted consulting workflow platform for PRISMA-PRIM and BIC.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "agent:doctor": "node scripts/agent-doctor.mjs",
    "agent:doctor:postgres": "node scripts/agent-doctor.mjs --profile postgres",
    "agent:doctor:web": "node scripts/agent-doctor.mjs --profile web",
    "agent:doctor:web-postgres": "node scripts/agent-doctor.mjs --profile web-postgres",
    "preflight:local": "node scripts/local-ci-preflight.mjs",
    "postgres:managed": "node scripts/managed-postgres.mjs",
    "build": "pnpm --recursive build",
    "dev": "pnpm --parallel --filter @prisma-prim/api --filter @prisma-prim/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm test:agent-governance && pnpm --recursive test",
    "test:unit": "pnpm test:agent-governance && pnpm --filter @prisma-prim/api test && pnpm --filter @prisma-prim/web exec vitest run",
    "test:access:postgres": "pnpm --filter @prisma-prim/api test:access:postgres",
    "test:company:postgres": "pnpm --filter @prisma-prim/api test:company:postgres",
    "test:client:postgres": "pnpm --filter @prisma-prim/api test:client:postgres",
    "test:preflight:postgres-smoke": "pnpm --filter @prisma-prim/api test:preflight:postgres-smoke",
    "test:preflight:migration": "pnpm --filter @prisma-prim/api test:preflight:migration",
    "test:preflight:playwright": "pnpm --filter @prisma-prim/web test:preflight:playwright",
    "test:agent-doctor": "node --test scripts/agent-doctor.test.mjs",
    "test:agent-governance": "node --test scripts/*.test.mjs",
    "check:complex-preflight": "node scripts/validate-complex-feature-preflight.mjs",
    "typecheck": "pnpm --recursive typecheck",
    "validate:iurie-coverage": "node scripts/validate-iurie-coverage.mjs",
    "db:generate": "pnpm --filter @prisma-prim/api db:generate",
    "db:migrate": "pnpm --filter @prisma-prim/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "mdast-util-from-markdown": "^2.0.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
