{
  "name": "prisma-prim-suite",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted consulting workflow platform for PRISMA-PRIM and BIC.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "dev": "pnpm --parallel --filter @prisma-prim/api --filter @prisma-prim/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "db:generate": "pnpm --filter @prisma-prim/api db:generate",
    "db:migrate": "pnpm --filter @prisma-prim/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
