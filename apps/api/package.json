{
  "name": "@prisma-prim/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:parallel && pnpm test:postgres:serial",
    "test:parallel": "vitest run --exclude \"src/**/*.rest.test.ts\" --exclude \"src/**/*.migration.test.ts\"",
    "test:postgres:serial": "vitest run --no-file-parallelism .rest.test.ts .migration.test.ts",
    "test:preflight:postgres-smoke": "vitest run src/company/company.rest.test.ts",
    "test:preflight:migration": "vitest run --no-file-parallelism src/database/previous-schema.migration.test.ts",
    "test:access:postgres": "vitest run --config vitest.postgres.config.ts src/access/access.rest.test.ts src/access/company-context-assignment.rest.test.ts src/access/workspace-membership-suspension.rest.test.ts src/access/workspace-membership.migration.test.ts",
    "test:company:postgres": "vitest run --config vitest.postgres.config.ts src/company/company.rest.test.ts src/company/company-idempotency.rest.test.ts",
    "test:client:postgres": "vitest run --config vitest.postgres.config.ts src/client/client.rest.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@clerk/backend": "3.16.1",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/node": "24.10.1",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
