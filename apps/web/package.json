{
  "name": "@prisma-prim/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run && pnpm test:browser:all",
    "test:browser": "playwright test",
    "test:browser:acceptance": "playwright test --config playwright.acceptance.config.ts",
    "test:browser:all": "pnpm test:browser && pnpm test:browser:acceptance",
    "test:preflight:playwright": "playwright test e2e/production-shell.spec.ts --grep \"renders the production shell\""
  },
  "dependencies": {
    "@clerk/localizations": "4.14.2",
    "@clerk/react": "6.13.1",
    "lucide-react": "0.468.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.178.0"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.178.1",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "fflate": "0.8.3"
  }
}
