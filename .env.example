# Local PostgreSQL started by compose.yaml
DATABASE_URL=postgresql://prisma_prim:prisma_prim@localhost:5432/prisma_prim

# NestJS API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Vite frontend
VITE_API_URL=http://localhost:3000/api

# Deterministic identity headers are accepted only with NODE_ENV=test, or in this
# explicitly named non-production demonstration mode. Omit in production.
NODE_ENV=development
ACCESS_IDENTITY_MODE=local-demo
VITE_ACCESS_IDENTITY_MODE=local-demo
VITE_DEMO_EXTERNAL_PROVIDER=local-demo
VITE_DEMO_EXTERNAL_SUBJECT=local-demonstration-user
VITE_DEMO_DISPLAY_NAME=Local demonstration user
VITE_DEMO_EMAIL=local-demo@example.test

# Clerk will be wired in a dedicated authentication issue.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
