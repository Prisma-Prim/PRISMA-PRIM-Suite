# Local PostgreSQL started by compose.yaml. Keep the numeric loopback host and the
# distinct `_test` database: the agent doctor and the destructive PostgreSQL test
# suites refuse any other target.
DATABASE_URL=postgresql://prisma_prim:prisma_prim@127.0.0.1:5432/prisma_prim
TEST_DATABASE_URL=postgresql://prisma_prim:prisma_prim@127.0.0.1:5432/prisma_prim_test

# NestJS API
API_PORT=3000
# Exact frontend origin (scheme + host + optional port, with no trailing slash
# or path). In production this is also Clerk's sole authorized party.
WEB_ORIGIN=http://localhost:5173

# Vite frontend
VITE_API_URL=http://localhost:3000/api

# Deterministic identity headers are accepted only with NODE_ENV=test, or in this
# explicitly named non-production demonstration mode. Filtered package commands
# do not load this root file automatically: export it into both terminals as shown
# in README's "Local identity demonstration". Normal production builds ignore
# these VITE_DEMO_* values even if they are accidentally present.
NODE_ENV=development
ACCESS_IDENTITY_MODE=local-demo
ACCESS_BOOTSTRAP_EXTERNAL_PROVIDER=local-demo
ACCESS_BOOTSTRAP_EXTERNAL_SUBJECT=local-demonstration-user
ACCESS_BOOTSTRAP_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
ACCESS_BOOTSTRAP_WORKSPACE_NAME="PRISMA Workspace"
ACCESS_ACCEPTED_INVITATIONS_JSON=[]
VITE_ACCESS_IDENTITY_MODE=local-demo
VITE_DEMO_EXTERNAL_PROVIDER=local-demo
VITE_DEMO_EXTERNAL_SUBJECT=local-demonstration-user
VITE_DEMO_DISPLAY_NAME="Local demonstration user"
VITE_DEMO_EMAIL=local-demo@example.test

# Clerk runtime configuration (values belong in environment secret stores).
# Invitation callbacks use WEB_ORIGIN/accept-invitation. Existing-account
# acceptance uses Clerk's Native API on the configured FAPI host. It must be
# available; the application fails closed and does not change Clerk settings.
# CLERK_SECRET_KEY also protects pending private invitation recovery tokens.
# Never expose that key or those tokens to the frontend or diagnostic logs.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
